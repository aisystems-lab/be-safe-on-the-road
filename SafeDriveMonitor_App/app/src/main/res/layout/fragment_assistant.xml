<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Header bar ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Voice Assistant"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Language badge -->
        <TextView
            android:id="@+id/tvLanguageBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="EN"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_lang_badge"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- ── Chat list ───────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Bottom panel ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/bg_bottom_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- State label -->
        <TextView
            android:id="@+id/tvListeningState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_hold_to_talk"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif" />

        <!-- Circular mic button -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <!-- Pulse ring (always visible, animated in code when listening) -->
            <View
                android:id="@+id/micPulse"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_pulse"
                android:alpha="0.3" />

            <!-- Mic button -->
            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button"
                android:src="@drawable/ic_mic"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/cd_mic_button"
                android:stateListAnimator="@null"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_hold_to_talk_sub"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
