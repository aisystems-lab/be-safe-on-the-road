# =====================================================================
# Be Safe on the Road — backend configuration (v2.5, OpenRouter)
#
# 1.  Copy this file:        cp .env.example .env
# 2.  Edit the values below and FILL IN your OpenRouter key.
# 3.  Make sure .env is in .gitignore (it already is). NEVER commit .env.
#
# Why OpenRouter?
#   One API key, one billing dashboard, one rate-limit policy. We use
#   :free models exclusively (zero per-token cost) for the multi-model
#   comparison, so a misconfigured run cannot bill the professor's card
#   so long as the dashboard credit cap stays at $0.
# =====================================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Vector store ---
VECTOR_STORE=chroma

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Reranker ---
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=3

# --- Retrieval ---
RETRIEVAL_TOP_K=10
FINAL_TOP_K=3
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
USE_MMR=true
MMR_LAMBDA=0.5

# =====================================================================
# OpenRouter — the only API key you need for the comparison.
# =====================================================================
# Get one at https://openrouter.ai/keys.
# CRITICAL: when creating the key, set "Credit limit" to 0 in the
# OpenRouter dashboard. Free models still work because they don't
# draw from credits, but a typo on a paid model ID can no longer charge.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Default single model used when LLM_PROVIDER=openrouter (server mode).
# compare_models.py iterates over OPENROUTER_MODELS instead.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TIMEOUT_SEC=60

# Optional but recommended (used for OpenRouter leaderboard attribution):
OPENROUTER_REFERER=https://besafe-research.local
OPENROUTER_APP_TITLE=Be Safe on the Road

# Models to benchmark in compare_models.py (--openrouter mode).
# Six diverse free models, all verified live on OpenRouter as of Apr 2026.
# If any of these stop being free, you'll get a 402 — the :free guard
# below will refuse to fall through silently.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-3-27b-it:free,minimax/minimax-m2.5:free,z-ai/glm-4.5-air:free,meta-llama/llama-3.3-70b-instruct:free

# Judge model — also free, and intentionally not in the list above
# (so the judge isn't grading something from its own family).
OPENROUTER_JUDGE_MODEL=openai/gpt-oss-120b:free

# Hard guard: refuse any model ID that doesn't end in ":free".
# Belt + braces alongside the dashboard credit cap. Override with
# --allow-paid on compare_models.py only if you have explicit budget
# approval AND a sane credit cap on the dashboard.
OPENROUTER_FREE_ONLY=true

# Free-tier rate limit is ~20 requests/minute/model. 4s between calls
# = 15 req/min, well under the cap. Bump higher if you see 429s.
OPENROUTER_PER_MODEL_COOLDOWN_SEC=4.0
OPENROUTER_MAX_RETRIES=5
OPENROUTER_RETRY_BASE_DELAY_SEC=8.0

# =====================================================================
# Production server LLM routing
# =====================================================================
# server.py uses these. For development / testing, pointing at
# OpenRouter (free) is the cheapest path. For production deployment,
# you'd switch to a paid OpenRouter model or a self-hosted Ollama.
LLM_PROVIDER=openrouter
LLM_FALLBACK=none

# =====================================================================
# LLM-as-judge (compare_models.py)
# =====================================================================
# Use OpenRouter's free judge so the whole pipeline is on one gateway.
JUDGE_PROVIDER=openrouter
JUDGE_TEMPERATURE=0.0
JUDGE_TIMEOUT_SEC=60

# =====================================================================
# Comparison run knobs
# =====================================================================
# Trials per (model, query). 1 for development runs; 3 for the final
# paper numbers (averages out one-off latency outliers). At 35 queries,
# trials=1 ~= 70 calls/model. trials=3 ~= 140 calls/model. Free-tier
# daily cap is 200/model, so trials=3 fits comfortably in one day.
COMPARE_TRIALS=1

# =====================================================================
# Optional — legacy direct-provider keys (LEAVE BLANK)
# =====================================================================
# These are kept for backward compatibility. With OpenRouter we don't
# need any of them. Leave empty to disable, or keep them OUT of git.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# =====================================================================
# Local Ollama (optional, no key needed)
# =====================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SEC=60

# =====================================================================
# Structured output / generation
# =====================================================================
USE_STRUCTURED_OUTPUT=true
MAX_ANSWER_TOKENS=200

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=besafe-road
